server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;

    # Liveness of nginx itself, independent of the backend.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Resolve the backend per request (not at startup), so nginx also starts while the backend
    # is not (yet) reachable; /api then answers 502 until it is. NGINX_LOCAL_RESOLVERS is set by
    # the base image entrypoint (15-local-resolvers.envsh) from /etc/resolv.conf.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    location /api/ {
        set $api_upstream ${API_URL};
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed assets never change.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Single-page app: unknown paths serve index.html, which is never cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
