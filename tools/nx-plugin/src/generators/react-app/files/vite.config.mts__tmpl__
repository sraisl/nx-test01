/// <reference types='vitest' />
import { defineConfig } from 'vite';
import react from '@vitejs/plugin-react';
import { nxReadySignal } from '@nx/vite/plugins/nx-ready-signal.plugin';

// Backend for /api during local development (rewritten by the `link` generator).
const API_TARGET = 'http://localhost:8080';

export default defineConfig(() => ({
  root: import.meta.dirname,
  cacheDir: '../../node_modules/.vite/apps/<%= name %>',
  server: {
    port: <%= port %>,
    host: 'localhost',
    proxy: {
      '/api': API_TARGET,
    },
  },
  preview: {
    port: <%= previewPort %>,
    host: 'localhost',
  },
  resolve: {
    tsconfigPaths: true,
  },
  plugins: [react(), nxReadySignal()],
  build: {
    outDir: '../../dist/apps/<%= name %>',
    emptyOutDir: true,
    reportCompressedSize: true,
    commonjsOptions: {
      transformMixedEsModules: true,
    },
  },
  test: {
    name: '<%= name %>',
    watch: false,
    globals: true,
    environment: 'jsdom',
    include: ['{src,tests}/**/*.{test,spec}.{js,mjs,cjs,ts,mts,cts,jsx,tsx}'],
    // JUnit report for the CI job summary (see build-test-summary).
    reporters: ['default', ['junit', { outputFile: './test-results/junit.xml' }]],
    coverage: {
      reportsDirectory: '../../coverage/apps/<%= name %>',
      provider: 'v8' as const,
    },
  },
}));
