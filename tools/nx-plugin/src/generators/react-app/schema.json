{
  "$schema": "https://json-schema.org/schema",
  "$id": "PlatformReactApp",
  "title": "React app",
  "type": "object",
  "cli": "nx",
  "properties": {
    "name": {
      "type": "string",
      "description": "Project name (apps/<name>).",
      "pattern": "^[a-z][a-z0-9-]{1,40}$",
      "$default": { "$source": "argv", "index": 0 },
      "x-prompt": "Project name?"
    },
    "backend": {
      "type": "string",
      "description": "Name of a spring-service used as /api backend (optional)."
    },
    "port": {
      "type": "number",
      "description": "Vite dev server port (default: first free port starting at 4200)."
    }
  },
  "required": ["name"]
}
